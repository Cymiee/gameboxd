{
  "name": "gameboxd",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "lib",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "build:lib": "npm run build --workspace=lib",
    "build:web": "npm run build --workspace=web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~5.8.0"
  }
}
